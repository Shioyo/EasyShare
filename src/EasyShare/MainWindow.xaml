<Window x:Class="EasyShare.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EasyShare · USB 投屏" Icon="Assets/easyshare.ico" Width="1280" Height="900" MinWidth="1060" MinHeight="700" Background="#F4F6FB" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
  <Grid Background="#F4F6FB">
  <Grid Margin="30,24,30,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/easyshare.png" Width="48" Height="48" Margin="0,0,13,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="EasyShare" FontFamily="Segoe UI" FontSize="25" FontWeight="Bold"/><TextBlock Text="连接小屏，打开更大的视野。" Style="{StaticResource Caption}" Margin="1,2,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <Border Background="#E8EDF9" CornerRadius="14" Padding="12,6" Margin="0,0,12,0"><TextBlock Text="USB 直连" FontSize="11" Foreground="#50638F"/></Border>
        <TextBlock x:Name="VersionText" Text="v0.5.1" FontFamily="Segoe UI" FontSize="12" Foreground="#8994AA" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" x:Name="ContentGrid">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="344"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="Sidebar" Margin="0,0,22,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
          <StackPanel>
            <Grid Margin="0,0,0,14"><TextBlock Text="我的设备" FontSize="15" FontWeight="SemiBold"/><Border HorizontalAlignment="Right" Background="#F0F4FA" CornerRadius="9" Padding="8,3"><TextBlock x:Name="ConnectionBadge" Text="等待连接" FontSize="10" Foreground="#627590"/></Border></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="DevicePicker" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}" SelectionChanged="Device_SelectionChanged" AutomationProperties.Name="选择投屏设备"/>
              <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Click="Refresh_Click" Margin="7,0,0,0" Padding="11,8" ToolTip="重新检测 USB 设备"/>
            </Grid>
            <TextBlock Text="使用数据线连接，并允许 USB 调试。" Style="{StaticResource Caption}" Margin="0,10,0,0" FontSize="11"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="20">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
              <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,16"/>
              <Button x:Name="StartButton" Content="开始投屏  →" Background="{StaticResource Accent}" Foreground="White" FontSize="14" MinHeight="46" Click="Start_Click" IsEnabled="False"/>
              <Button x:Name="StopButton" Content="结束投屏" Click="Stop_Click" IsEnabled="False" Margin="0,8,0,0" MinHeight="36" Padding="12,6"/>
            </StackPanel>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="投屏设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,17"/>
              <TabControl x:Name="SettingsTabs" Grid.Row="1" AutomationProperties.Name="投屏设置分类">
                <TabItem Header="画面">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
                    <TextBlock Text="画质预设" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="QualityPicker" SelectedIndex="0" SelectionChanged="Options_Changed" AutomationProperties.Name="画质"><ComboBoxItem Content="流畅 · 60 FPS"/><ComboBoxItem Content="清晰 · 原分辨率 · 60 FPS"/><ComboBoxItem Content="轻量 · 30 FPS"/></ComboBox>
                    <TextBlock Text="帧率为上限，清晰模式适合阅读小字。" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,19"/>
                    <TextBlock Text="视频码率" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="BitratePicker" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="Options_Changed" AutomationProperties.Name="视频码率">
                      <ComboBoxItem Content="自动 · 随画质调整" Tag="0"/><ComboBoxItem Content="4 Mbps" Tag="4"/><ComboBoxItem Content="8 Mbps" Tag="8"/><ComboBoxItem Content="12 Mbps" Tag="12"/><ComboBoxItem Content="20 Mbps" Tag="20"/><ComboBoxItem Content="32 Mbps" Tag="32"/><ComboBoxItem Content="50 Mbps" Tag="50"/><ComboBoxItem Content="80 Mbps" Tag="80"/>
                    </ComboBox>
                    <TextBlock x:Name="BitrateHint" Text="自动：清晰 32，其余 12 Mbps。" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,17"/>
                    <Expander Header="兼容与连接" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"><StackPanel Margin="0,12,0,4"><CheckBox x:Name="JpegMode" Content="HDC 兼容画面" Checked="Options_Changed" Unchecked="Options_Changed" FontSize="11"/><TextBlock Text="仅 HDC 画面异常时使用。" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,8"/><Button Content="选择 HDC 工具…" Click="ChooseHdc_Click" FontSize="11"/></StackPanel></Expander>
                    <TextBlock Text="更改设置后，重新开始投屏生效。" Style="{StaticResource Caption}" FontSize="11" Margin="0,13,0,0"/>
                  </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="声音">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
                    <CheckBox x:Name="AudioEnabledBox" Content="声音传到电脑" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <TextBlock x:Name="AudioHint" Text="开启后，平板声音由电脑播放。" Style="{StaticResource Caption}" Margin="0,9,0,25"/>
                    <TextBlock Text="音频码率" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="AudioBitratePicker" SelectedIndex="1" SelectedValuePath="Tag" AutomationProperties.Name="音频码率"><ComboBoxItem Content="64 kbps · 节省带宽" Tag="64"/><ComboBoxItem Content="128 kbps · 标准" Tag="128"/><ComboBoxItem Content="192 kbps · 高音质" Tag="192"/><ComboBoxItem Content="256 kbps · 高音质" Tag="256"/></ComboBox>
                    <Border Background="#F3F6FC" CornerRadius="10" Padding="13" Margin="0,18,0,0"><TextBlock Text="音量使用 Windows 音量控制。码率是编码目标，实际听感也取决于音源。" Style="{StaticResource Caption}" FontSize="11"/></Border>
                    <TextBlock Text="更改设置后，重新开始投屏生效。" Style="{StaticResource Caption}" FontSize="11" Margin="0,18,0,0"/>
                  </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="键盘">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
                    <CheckBox x:Name="TabletImeBox" Content="使用平板输入法" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <TextBlock Text="使用平板当前输入法，不限定小艺。" Style="{StaticResource Caption}" Margin="0,9,0,19"/>
                    <Border Background="#EFF4FF" CornerRadius="12" Padding="15"><StackPanel><TextBlock Text="中文输入小提示" FontSize="12" FontWeight="SemiBold" Foreground="#3457AF" Margin="0,0,0,8"/><TextBlock x:Name="TabletImeHint" Text="电脑输入法保持英文，平板启用支持外接键盘的中文输入法。用电脑打拼音，由平板输入法显示候选、选词。" Style="{StaticResource Caption}" Foreground="#526994"/></StackPanel></Border>
                    <TextBlock Text="更改后重新投屏。此模式不直接传输 Windows 输入法选好的中文。" Style="{StaticResource Caption}" FontSize="11" Margin="0,17,0,0"/>
                  </StackPanel></ScrollViewer>
                </TabItem>
              </TabControl>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="2,0,0,14"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="投屏工作台" FontSize="17" FontWeight="SemiBold"/><TextBlock Text=" /  SCREEN MIRRORING" FontFamily="Segoe UI" Foreground="#96A0B3" FontSize="10" VerticalAlignment="Center" Margin="9,2,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ShotButton" Content="截图" Click="Screenshot_Click" IsEnabled="False" Padding="13,7" MinHeight="34" Margin="0,0,8,0" ToolTip="HDC 内置画面截图"/><Button x:Name="FullscreenButton" Content="全屏  F11" Click="Fullscreen_Click" Padding="13,7" MinHeight="34" ToolTip="HDC 内置画面全屏；ADB 画面窗口使用 Alt + F"/></StackPanel></Grid>
        <Border Grid.Row="1" CornerRadius="20" ClipToBounds="True">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#142441" Offset="0"/><GradientStop Color="#0C162C" Offset="1"/></LinearGradientBrush></Border.Background>
          <Grid>
            <TextBlock Text="EASYSHARE  /  USB" FontFamily="Segoe UI" FontSize="10" Foreground="#6B83A5" Margin="24,20,0,0" VerticalAlignment="Top"/>
            <Viewbox x:Name="Placeholder" Stretch="Uniform" StretchDirection="DownOnly" Margin="30,36">
            <StackPanel Width="450">
              <Viewbox Width="234" Height="160" Margin="0,0,0,27"><Canvas Width="280" Height="190">
                <Ellipse Width="218" Height="100" Fill="#152D51" Canvas.Left="35" Canvas.Top="48"/>
                <Rectangle Width="194" Height="121" RadiusX="12" RadiusY="12" Fill="#203A62" Stroke="#6689BD" StrokeThickness="2" Canvas.Left="65" Canvas.Top="16"/>
                <Rectangle Width="172" Height="99" RadiusX="6" RadiusY="6" Canvas.Left="76" Canvas.Top="27"><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#284577" Offset="0"/><GradientStop Color="#456BB0" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                <Path Data="M 144 139 L 144 157 M 118 158 L 171 158" Stroke="#6689BD" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Rectangle Width="91" Height="130" RadiusX="12" RadiusY="12" Fill="#142743" Stroke="#93BAF0" StrokeThickness="2" Canvas.Left="21" Canvas.Top="51"/>
                <Rectangle Width="73" Height="100" RadiusX="5" RadiusY="5" Fill="#315B94" Canvas.Left="30" Canvas.Top="63"/>
                <Path Data="M 54 172 L 78 172" Stroke="#93BAF0" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 92 119 L 170 66 M 144 64 L 176 61 L 173 93" Stroke="#8DE7E0" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Canvas></Viewbox>
              <TextBlock x:Name="PlaceholderTitle" Text="把设备画面，带到大屏幕" Foreground="#F1F5FF" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock x:Name="PlaceholderDetail" Text="连接 USB 数据线，在设备上允许调试，&#10;即可开始你的大屏体验。" Foreground="#A2B3CC" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="440" LineHeight="23"/>
              <Border Background="#1D3152" CornerRadius="13" Padding="12,6" HorizontalAlignment="Center" Margin="0,23,0,0"><TextBlock Text="画面通过 USB 在本机传输" Foreground="#96B4DE" FontSize="10"/></Border>
            </StackPanel>
            </Viewbox>
            <wv:WebView2 x:Name="Player" Visibility="Collapsed" DefaultBackgroundColor="#0C162C"/>
          </Grid>
        </Border>
        <TextBlock x:Name="StreamInfo" Grid.Row="2" Text="Android / HarmonyOS · USB 有线连接" Style="{StaticResource Caption}" FontSize="11" Margin="3,12,0,14"/>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,10,0"><StackPanel><TextBlock Text="鼠标即触控" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="ADB · 左键点击、按住拖动" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
          <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,10,0"><StackPanel><TextBlock Text="快捷导航" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="ADB · 右键返回、中键主页" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
          <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,14"><StackPanel><TextBlock Text="更大的视野" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="ADB 画面窗口  Alt + F" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
        </Grid>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="2,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <DockPanel VerticalAlignment="Center" Margin="0,0,12,0"><Ellipse Width="6" Height="6" Fill="#8396B6" Margin="0,0,9,0"/><TextBlock x:Name="StatusText" Text="正在检查投屏环境…" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></DockPanel>
      <Button Grid.Column="1" Content="诊断日志" Click="Logs_Click" FontSize="11" Padding="12,5" MinHeight="30" Background="Transparent"/>
    </Grid>
  </Grid>
  </Grid>
</Window>
