<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.5.2</Version>
    <ApplicationIcon>Assets\easyshare.ico</ApplicationIcon>
    <RuntimeFrameworkVersion>8.0.32</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\easyshare.png" />
    <Resource Include="Assets\easyshare.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <Content Include="Player\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
